[libfprint-elanpress]
name=libfprint elanpress for Fedora 44 (x86_64)
baseurl=https://raw.githubusercontent.com/iovcho/libfprint-elanpress/repo/44/x86_64
enabled=1
# Built in public GitHub Actions and published unsigned.
# Fedora's own repositories set gpgcheck=1.
gpgcheck=0
